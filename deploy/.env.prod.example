# Inventory only: put actual values in the GitHub production environment's Secrets.
# CD generates /opt/hanmaum/releases/<release>/.env.prod, owned by root with mode 600.
# These values are read by Compose; the application receives only explicitly mapped variables.
# Actions supplies a tested Linux/amd64 GHCR image pinned by sha256 digest.
BACKEND_IMAGE=

# Different random passwords for the PostgreSQL administrator and application role.
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=

# Google: the Web application OAuth client ID and its client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao: the REST API key (not the JavaScript/admin key) and its matching client secret.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Generate each independently with: openssl rand -base64 32
# Keep these stable across deployments and back them up separately from the database.
COMMAND_DIGEST_KEY=
INVITATION_ENCRYPTION_KEY=
AI_INTERNAL_API_KEY=
