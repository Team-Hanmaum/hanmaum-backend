# Local development only. Values use .properties syntax: no surrounding quotes.
POSTGRES_DB=hanmaum
POSTGRES_USER=hanmaum
POSTGRES_PASSWORD=hanmaum-local-only
POSTGRES_PORT=5432
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# FE route is not agreed yet; this prefix is for local API verification only.
INVITATION_URL_PREFIX=http://localhost:5173/invitations/
# Optional locally. Required in production: Base64 of 32 cryptographically random bytes.
# Separate from COMMAND_DIGEST_KEY; retain across restarts/instances to replay issued URLs.
# INVITATION_ENCRYPTION_KEY=

# Optional locally (a local-only default is provided). Required in production: random secret >= 32 bytes.
# Keep stable across restarts and all instances; changing it requires a receipt migration plan.
# COMMAND_DIGEST_KEY=

# Internal FastAPI service. Never put the LLM provider key in this repository.
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=local-development-only

# Initial local/integration limits (v2-20261021.1). local profile supplies these defaults.
# Other profiles require explicit budgets; values cannot exceed the agreed wire caps.
# v1 runs do not require these budgets. v2 runs fail safely if budgets are absent.
# AI_V2_MAX_REQUEST_BYTES=1048576
# AI_V2_MAX_RESPONSE_BYTES=524288

# Version pinned on NEW runs; old runs keep their accepted version.
# Switch to v2 only after AI v2 readiness and integration verification. No automatic fallback.
ANALYSIS_CONTRACT_VERSION=v1

# Opt-in analysis worker. Operating values are undecided: no numeric defaults.
# When disabled, source submission still persists a QUEUED job; no AI request is sent.
ANALYSIS_WORKER_ENABLED=false
# ANALYSIS_WORKER_CONCURRENCY=
# ANALYSIS_WORKER_POLL_INTERVAL=
# ANALYSIS_WORKER_LEASE_DURATION=

# Fill these when testing with the additional oauth profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
